# === НАСТРОЙКИ АДМИН-БОТА ===
# Токен бота для админ-панели (создайте отдельного бота у @BotFather)
ADMIN_BOT_TOKEN=your_admin_bot_token_here

# Ваш Telegram ID (получите у @userinfobot)
ADMIN_TELEGRAM_ID=your_telegram_id_here

# === ТОКЕН ДЛЯ ПЕРВОЙ ОРГАНИЗАЦИИ (опционально) ===
# Этот токен можно использовать при создании первой организации
BOT_TOKEN=your_organization_bot_token_here
